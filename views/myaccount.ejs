<style>
  .account-container {
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 80vh;
    /* background: rgb(15, 23, 42); */
    background: linear-gradient(to bottom right, #0f0f0f, #1a1a1a);
  }

  .account-card {
    background: rgba(20, 20, 20, 0.6);
    border-radius: 20px;
    padding: 30px;
    width: 360px;
    color: #fff;
    backdrop-filter: blur(12px);
    box-shadow: 0 0 25px rgba(0, 0, 0, 0.7);
    text-align: center;
    border: 1px solid rgba(255, 255, 255, 0.1);
    transition: transform 0.9s ease, box-shadow 0.9s ease;
    /* box-shadow: 0 0 35px rgba(0, 255, 255, 0.3);*/
  }

  .account-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 0 35px rgba(0, 255, 255, 0.3);
  }

  .profile-heading {
    font-size: 22px;
    margin-bottom: 10px;
    font-weight: 600;
    color: #00e5ff;
  }

  .profile-icon img {
    width: 120px;
    height: 120px;
    border-radius: 50%;
    border: 2px solid #00e5ff;
    background-color: #222;
    margin-bottom: 15px;
  }

  .username {
    font-size: 24px;
    margin-bottom: 10px;
    font-weight: 600;
  }

  .account-details p {
    margin: 10px 0;
    font-size: 16px;
  }

  .account-details a {
    color: #00bcd4;
    text-decoration: none;
  }

  .account-details a:hover {
    text-decoration: underline;
  }
</style>




<% layout("/layouts/boilerplate") %>

  <div class="account-container">
    <div class="account-card">
      <h2 class="profile-heading">My Profile</h2>
      <div class="profile-icon">
        <img src="https://cdn-icons-png.flaticon.com/512/149/149071.png" alt="Profile Picture"
          class="rounded-circle mx-auto d-block" style="width: 120px; height: 120px; object-fit: cover; <%= currentUser.isPro ? 'border-color: #ffd700; box-shadow: 0 0 20px rgba(255, 215, 0, 0.4);' : '' %>">
      </div>
      <h2 class="username">Welcome - <%= currentUser.username %>
        <% if (currentUser.isPro) { %>
          <i class="fas fa-crown" style="color: #ffd700; font-size: 1.2rem; margin-left: 8px; text-shadow: 0 0 10px rgba(255, 215, 0, 0.5);" title="Pro Member"></i>
        <% } %>
      </h2>
      <div class="account-details">
        <p><strong>Status:</strong> 
          <% if (currentUser.isPro) { %>
            <span style="color: #ffd700; font-weight: bold;"><i class="fas fa-crown"></i> PRO Member</span>
          <% } else { %>
            <span style="color: #ccc;">FREE</span> (<a href="/upgrade" style="color: #ffd700;">Upgrade to PRO</a>)
          <% } %>
        </p>
        <p><strong>Email:</strong>
          <%= currentUser.email %>
        </p>
        <p><strong>Explore:</strong> <a href="/explore">Explore All</a></p>
        <p><strong>My MoodBoards:</strong> <a href="/moodboards">View MoodBoards</a></p>
        <p><strong>AI-Recommendations:</strong> <a href="/recommended">Movies For You..</a></p>
      </div>
      
      <!-- Notifications Section -->
      <div class="notifications-section">
        <h4 class="notifications-title"><i class="fas fa-bell"></i> Notifications & Replies</h4>
        
        <% if (typeof userContacts !== 'undefined' && userContacts.length > 0) { %>
          <% const repliedContacts = userContacts.filter(c => c.status === 'Replied'); %>
          <% if (repliedContacts.length > 0) { %>
            <div class="notifications-list">
              <% repliedContacts.forEach(contact => { %>
                <div class="notification-item">
                  <div class="notification-header">
                    <strong class="subject">Re: <%= contact.subject || 'Your Inquiry' %></strong>
                    <span class="date"><%= new Date(contact.createdAt).toLocaleDateString() %></span>
                  </div>
                  <p class="user-msg">"<%= contact.message.length > 50 ? contact.message.substring(0, 50) + '...' : contact.message %>"</p>
                  <div class="admin-reply-box">
                    <strong><i class="fas fa-headset"></i> Support Reply:</strong>
                    <p class="reply-text"><%= contact.adminReply %></p>
                  </div>
                </div>
              <% }) %>
            </div>
          <% } else { %>
            <div class="empty-state">
              <i class="fas fa-inbox"></i>
              <p>Your queries are currently being reviewed. You will receive a notification here once an admin replies.</p>
            </div>
          <% } %>
        <% } else { %>
          <div class="empty-state">
            <i class="fas fa-envelope-open-text"></i>
            <p>You haven't submitted any contact queries yet. Once you do, admin replies will appear here.</p>
          </div>
        <% } %>
      </div>
    </div>
  </div>

<style>
.notifications-section {
  margin-top: 30px;
  text-align: left;
  background: rgba(0, 0, 0, 0.2);
  border-radius: 12px;
  padding: 20px;
  border: 1px solid rgba(255, 255, 255, 0.05);
}
.notifications-title {
  color: #00e5ff;
  border-bottom: 1px solid rgba(0, 229, 255, 0.3);
  padding-bottom: 10px;
  margin-bottom: 20px;
  font-size: 1.3rem;
}
.notifications-list {
  display: flex;
  flex-direction: column;
  gap: 15px;
}
.notification-item {
  background: rgba(255, 255, 255, 0.03);
  border-left: 4px solid #00e5ff;
  padding: 15px;
  border-radius: 0 8px 8px 0;
  transition: background 0.3s;
}
.notification-item:hover {
  background: rgba(255, 255, 255, 0.06);
}
.notification-header {
  display: flex;
  justify-content: space-between;
  margin-bottom: 8px;
}
.notification-header .subject {
  color: #ffcc70;
  font-size: 1.1rem;
}
.notification-header .date {
  color: #aaa;
  font-size: 0.85rem;
}
.user-msg {
  color: #aaa;
  font-style: italic;
  font-size: 0.9rem;
  margin-bottom: 12px;
}
.admin-reply-box {
  background: rgba(0, 229, 255, 0.08);
  padding: 12px;
  border-radius: 8px;
}
.admin-reply-box strong {
  color: #00e5ff;
  font-size: 0.9rem;
  display: block;
  margin-bottom: 5px;
}
.reply-text {
  color: #fff;
  margin: 0;
  font-size: 0.95rem;
  line-height: 1.5;
}
.empty-state {
  text-align: center;
  padding: 20px 0;
  color: #888;
}
.empty-state i {
  font-size: 2rem;
  margin-bottom: 10px;
  color: #555;
}
.empty-state p {
  margin: 0;
  font-size: 0.95rem;
}
</style>